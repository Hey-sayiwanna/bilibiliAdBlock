#!name=B站去广告增强整合版
#!desc=信息流 + 搜索 + 直播 + splash + 播放器下方广告补丁
#!author=dqzboy + merged
#!category=Surge去广告
#!date=2026-04-16

[Rule]
DOMAIN,app.biliapi.net,REJECT
DOMAIN,api.biliapi.net,REJECT
DOMAIN,app.biliapi.com,REJECT
DOMAIN,api.biliapi.com,REJECT

[Body Rewrite]
http-response-jq ^https:\/\/app\.bilibili\.com\/x\/v2\/splash\/(list|show|event\/list2)\? '.data |= with_entries(if .key | IN("show", "event_list") then .value = [] else . end)'

[Script]

# =========================
# 首页信息流去广告
# =========================
bilibili-feed-ad = type=http-response,pattern=^https:\/\/app\.bilibili\.com\/x\/v2\/feed\/index\?,script-path=https://klraw.pages.dev/kelv1n1n/script/refs/heads/main/js/bilibili-ad.js?token=209863,requires-body=true,max-size=-1,timeout=60

# 搜索页推荐
bilibili-search-ad = type=http-response,pattern=^https:\/\/app\.bilibili\.com\/x\/v2\/search\/square,script-path=https://klraw.pages.dev/kelv1n1n/script/refs/heads/main/js/bilibili-ad.js?token=209863,requires-body=true,max-size=-1,timeout=60

# 首页右上角活动图标
bilibili-top-ad = type=http-response,pattern=^https:\/\/app\.bilibili\.com\/x\/resource\/top\/activity\?,script-path=https://klraw.pages.dev/kelv1n1n/script/refs/heads/main/js/bilibili-ad.js?token=209863,requires-body=true,max-size=-1,timeout=60

# 我的页面
bilibili-mine-ad = type=http-response,pattern=^https:\/\/app\.bilibili\.com\/x\/v2\/account\/mine,script-path=https://klraw.pages.dev/kelv1n1n/script/refs/heads/main/js/bilibili-ad.js?token=209863,requires-body=true,max-size=-1,timeout=60

# 直播 feed
bilibili-live-feed-ad = type=http-response,pattern=^https:\/\/api\.live\.bilibili\.com\/xlive\/(?:app-interface\/v2\/index\/feed|app-room\/v1\/index\/getInfoBy(?:Room|User))\?,script-path=https://klraw.pages.dev/kelv1n1n/script/refs/heads/main/js/bilibili-ad.js?token=209863,requires-body=true,max-size=-1,timeout=60

# 直播tab banner
bilibili-live-tab-ad = type=http-response,pattern=^https:\/\/api\.live\.bilibili\.com\/xlive\/app-interface\/v2\/second\/getList,script-path=https://klraw.pages.dev/kelv1n1n/script/refs/heads/main/js/bilibili-ad.js?token=209863,requires-body=true,max-size=-1,timeout=60

# =========================
# ⭐ 新增：播放器下方商业卡补丁
# =========================
Bili.Player.AdPatch = type=http-response,pattern=^https?:\/\/(grpc|app)\.bili(bili\.com|api\.net)\/bilibili\.app\.(view|viewunite)\.v1\.View\/(View|RelatesFeed)$,requires-body=1,binary-body-mode=1,engine=webview,max-size=262144,script-path=https://github.com/BiliUniverse/ADBlock/releases/download/v0.6.24/response.bundle.js

[MITM]
hostname = %APPEND% app.bilibili.com,api.live.bilibili.com,app.biliapi.net,grpc.biliapi.net
h2 = true